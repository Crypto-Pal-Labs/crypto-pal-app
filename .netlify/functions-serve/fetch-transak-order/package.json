{
  "name": "crypto-pal-app",
  "version": "1.0.0",
  "private": true,
  "resolutions": {
    "wrap-ansi": "7.0.0",
    "string-width": "4.1.0",
    "@noble/hashes": "^1.8.0",
    "strip-ansi": "6.0.1",
    "metro": "^0.82.0",
    "metro-config": "^0.82.0",
    "metro-resolver": "^0.82.0",
    "@expo/config-plugins": "^10.1.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev:functions": "netlify dev",
    "dev:functions:win": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"netlify dev\"",
    "clean:win": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item -Recurse -Force node_modules,.expo,android\\app\\build -ErrorAction SilentlyContinue\"",
    "clean": "rimraf node_modules .expo android/app/build",
    "doctor": "expo-doctor",
    "build:apk": "eas build -p android --profile preview",
    "build:internal": "eas build -p android --profile internal",
    "submit:internal": "eas submit -p android --profile internal --latest",
    "build:aab": "eas build -p android --profile production",
    "submit:prod": "eas submit -p android --profile production --latest",
    "test": "node test-config/runTests.js",
    "test:unit": "jest --testPathPatterns=unit",
    "test:integration": "jest --testPathPatterns=integration",
    "test:visual": "jest --testPathPatterns=visual",
    "test:api": "jest --testPathPatterns=api",
    "test:e2e": "npx playwright test --config=test-config/playwright.config.ts",
    "test:performance": "npx playwright test --config=test-config/playwright.config.ts --grep=\"Performance\"",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
