{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["es2020"],
    "jsx": "react-native",

    // ✅ Required so "customConditions" is valid (and recommended for RN)
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],

    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    "baseUrl": ".",
    "paths": { "~/*": ["src/*"] },
    "types": ["react", "react-native", "jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", "App.tsx", "app.config.js"],
  "exclude": ["node_modules", "android", "ios"]
}