{
  "cli": {
    "version": ">=16.20.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug",
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "node": "20.19.4"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": true
      }
    },
    "test-apk": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_COVALENT_KEY": "$(COVALENT_KEY)",
        "EXPO_PUBLIC_TRANSAK_API_KEY": "$(TRANSAK_API_KEY)",
        "EXPO_PUBLIC_ETHERSCAN_BASE": "$(ETHERSCAN_BASE)",
        "EXPO_PUBLIC_ETH_RPC_URL": "$(ETH_RPC_URL)",
        "EXPO_PUBLIC_BSC_RPC_URL": "$(BSC_RPC_URL)",
        "EXPO_PUBLIC_BSCSCAN_BASE": "$(BSCSCAN_BASE)",
        "EXPO_PUBLIC_WALLET_CONNECT_PROJECT_ID": "$(WALLET_CONNECT_PROJECT_ID)",
        "EXPO_PUBLIC_ONE_INCH_API_KEY": "$(ONE_INCH_API_KEY)",
        "EXPO_PUBLIC_ONE_INCH_API_BASE": "$(ONE_INCH_API_BASE)",
        "EXPO_PUBLIC_UNISWAP_ROUTER_ADDRESS": "$(UNISWAP_ROUTER_ADDRESS)",
        "EXPO_PUBLIC_USDC_ADDRESS": "$(USDC_ADDRESS)",
        "EXPO_PUBLIC_WETH_ADDRESS": "$(WETH_ADDRESS)",
        "EXPO_PUBLIC_CONTRACT_ADDRESS": "$(CONTRACT_ADDRESS)",
        "EXPO_PUBLIC_ALCHEMY_KEY": "$(ALCHEMY_KEY)",
        "EXPO_PUBLIC_POLYGON_RPC_URL": "$(POLYGON_RPC_URL)"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_COVALENT_KEY": "$(COVALENT_KEY)",
        "EXPO_PUBLIC_TRANSAK_API_KEY": "$(TRANSAK_API_KEY)",
        "EXPO_PUBLIC_ETHERSCAN_BASE": "$(ETHERSCAN_BASE)",
        "EXPO_PUBLIC_ETH_RPC_URL": "$(ETH_RPC_URL)",
        "EXPO_PUBLIC_BSC_RPC_URL": "$(BSC_RPC_URL)",
        "EXPO_PUBLIC_BSCSCAN_BASE": "$(BSCSCAN_BASE)",
        "EXPO_PUBLIC_WALLET_CONNECT_PROJECT_ID": "$(WALLET_CONNECT_PROJECT_ID)",
        "EXPO_PUBLIC_ONE_INCH_API_KEY": "$(ONE_INCH_API_KEY)",
        "EXPO_PUBLIC_ONE_INCH_API_BASE": "$(ONE_INCH_API_BASE)",
        "EXPO_PUBLIC_UNISWAP_ROUTER_ADDRESS": "$(UNISWAP_ROUTER_ADDRESS)",
        "EXPO_PUBLIC_USDC_ADDRESS": "$(USDC_ADDRESS)",
        "EXPO_PUBLIC_WETH_ADDRESS": "$(WETH_ADDRESS)",
        "EXPO_PUBLIC_CONTRACT_ADDRESS": "$(CONTRACT_ADDRESS)",
        "EXPO_PUBLIC_ALCHEMY_KEY": "$(ALCHEMY_KEY)",
        "EXPO_PUBLIC_POLYGON_RPC_URL": "$(POLYGON_RPC_URL)"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "buildType": "archive"
      },
      "node": "20.19.4"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "path/to/your/service-account-key.json",
        "track": "internal"
      }
    }
  }
}