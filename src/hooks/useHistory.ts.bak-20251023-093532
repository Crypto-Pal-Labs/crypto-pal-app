import { useState, useEffect, useCallback } from "react";
import { Alert } from "react-native";
import { useWalletStore } from "../store/useWalletStore";
import { covalentGet, CovalentError } from "../lib/covalent";
import { EvmChain } from "../config/chainRegistry";
import { useChain } from "../hooks/useChain";

/**
 * Minimal normalized transaction item for UI consumption.
 * We keep the original Covalent item in `raw` for any advanced needs.
 */
export type TxItem = {
  hash: string;
  timestamp: string;
  from: string;
  to: string;
  valueWei: string;
  chainId: number;
  explorerBase: string;
  nativeSymbol: "ETH" | "BNB" | "MATIC";
  successful: boolean;
  raw: any;
};

const toTxItems = (items: any[], c: EvmChain): TxItem[] =>
  (items || []).map((t: any) => ({
    hash: t.tx_hash || t.hash || "",
    timestamp: t.block_signed_at || t.timestamp || new Date().toISOString(),
    from: (t.from_address || "").toLowerCase(),
    to: (t.to_address || "").toLowerCase(),
    valueWei: String(t.value || t.value_wei || "0"),
    chainId: c.chainId,
    explorerBase: c.explorerBase || "",
    nativeSymbol: (c.nativeSymbol as "ETH" | "BNB" | "MATIC") || "ETH",
    successful: t.successful === false ? false : true,
    raw: t,
  }));

export const useHistory = () => {
  const address = useWalletStore((s) => s.address);
  const { chain } = useChain(); // current active chain only

  const [transactions, setTransactions] = useState<TxItem[]>([]);
  const [loading, setLoading] = useState<boolean>(true);
  const [error, setError] = useState<string | null>(null);

  const fetchHistory = useCallback(async () => {
    if (!address) {
      setError("No wallet address found.");
      setTransactions([]);
      setLoading(false);
      return;
    }

    setLoading(true);
    setError(null);

    try {
      const owner = address.toLowerCase();

      // If this chain is marked unsupported by Covalent, short-circuit with empty for now.
      // (Wallet balances already have an RPC fallback; history can be enhanced later if needed.)
      if (chain?.covalentSupported === false) {
        setTransactions([]);
        setLoading(false);
        return;
      }

      const url = `https://api.covalenthq.com/v1/${encodeURIComponent(
        chain.covalentChainId as any
      )}/address/${owner}/transactions_v3/?no-logs=true&page-size=50`;

      let json: any;
      try {
        json = await covalentGet(url);
      } catch (e: any) {
        // Skip showing hard errors for unsupported / rate / transient — leave last known list
        if (e instanceof CovalentError) {
          if (e.status === 501) { setLoading(false); return; }
          if (e.status === 429)  { setLoading(false); return; }
        }
        const msg = String(e?.message || e);
        setError(msg);
        setLoading(false);
        return;
      }

      const items = json?.data?.items ?? [];
      const list = toTxItems(items, chain);
      setTransactions(list);
    } catch (e: any) {
      const msg = String(e?.message || e);
      setError(msg);
      Alert.alert("Load Error", `Failed to load history: ${msg}. Pull to refresh.`);
    } finally {
      setLoading(false);
    }
  }, [address, chain?.chainId, chain?.covalentChainId, chain?.covalentSupported, chain?.explorerBase, chain?.nativeSymbol]);

  useEffect(() => {
    fetchHistory();
  }, [fetchHistory]);

  return { transactions, loading, error, refetch: fetchHistory };
};
